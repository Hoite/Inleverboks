{% extends "base.html.j2" %}
{% block title %}{{ _("System log") }} · {{ app_name }}{% endblock %}
{% block content %}
<h1>{{ _("Admin") }}</h1>
{% include "admin/_nav.html.j2" %}
<form method="get" action="/admin/auditlog" class="row-form">
  <div class="field grow">
    <label for="event">{{ _("Filter on event") }}</label>
    <input id="event" name="event" type="text" value="{{ event_filter }}" placeholder="login" autocomplete="off">
  </div>
  <button type="submit" class="button button-secondary">{{ _("Filter") }}</button>
  <a class="button button-secondary" href="/admin/auditlog?format=csv&amp;event={{ event_filter|urlencode }}">{{ _("Export CSV") }}</a>
  <a class="button button-secondary" href="/admin/auditlog?format=pdf&amp;event={{ event_filter|urlencode }}">{{ _("Export PDF") }}</a>
</form>
<div class="table-wrap">
<table class="audit-table">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">{{ _("Time") }}</th>
      <th scope="col">{{ _("Actor") }}</th>
      <th scope="col">{{ _("IP address") }}</th>
      <th scope="col">{{ _("Event") }}</th>
      <th scope="col">{{ _("Details") }}</th>
    </tr>
  </thead>
  <tbody>
  {% for e in events %}
    <tr>
      <td>{{ e.seq }}</td>
      <td>{{ e.ts|localtime("%d-%m-%Y %H:%M:%S") }}</td>
      <td>{{ e.actor_label }}</td>
      <td class="mono">{{ e.ip or "" }}</td>
      <td class="mono">{{ e.event }}</td>
      <td class="mono small">{{ e.details|tojson }}</td>
    </tr>
  {% else %}
    <tr><td colspan="6" class="muted">{{ _("No events.") }}</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endblock %}
