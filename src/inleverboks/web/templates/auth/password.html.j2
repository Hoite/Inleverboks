{% extends "base.html.j2" %}
{% from "_macros.html.j2" import csrf, errors_box with context %}
{% block title %}{{ _("Change password") }} · {{ app_name }}{% endblock %}
{% block content %}
<div class="narrow">
  <h1>{{ _("Change password") }}</h1>
  {% if forced %}<p>{{ _("Choose a new password before you continue.") }}</p>{% endif %}
  {{ errors_box(errors) }}
  <form method="post" action="/account/wachtwoord" class="stack">
    {{ csrf() }}
    <div class="field">
      <label for="current">{{ _("Current password") }}</label>
      <input id="current" name="current" type="password" autocomplete="current-password" required autofocus>
    </div>
    <div class="field">
      <label for="new">{{ _("New password") }}</label>
      <input id="new" name="new" type="password" autocomplete="new-password" required minlength="{{ min_length }}" aria-describedby="new-hint">
      <p class="hint" id="new-hint">{{ _("At least %(n)s characters. Avoid common passwords.", n=min_length) }}</p>
    </div>
    <div class="field">
      <label for="confirm">{{ _("Repeat new password") }}</label>
      <input id="confirm" name="confirm" type="password" autocomplete="new-password" required minlength="{{ min_length }}">
    </div>
    <button type="submit" class="button">{{ _("Save") }}</button>
  </form>
</div>
{% endblock %}
