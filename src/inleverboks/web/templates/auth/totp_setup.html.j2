{% extends "base.html.j2" %}
{% from "_macros.html.j2" import csrf, errors_box with context %}
{% block title %}{{ _("Set up two-step verification") }} · {{ app_name }}{% endblock %}
{% block content %}
<div class="narrow">
  <h1>{{ _("Set up two-step verification") }}</h1>
  {% if forced %}<p>{{ _("Two-step verification is mandatory for your account.") }}</p>{% endif %}
  {{ errors_box(errors) }}
  <ol class="steps">
    <li>{{ _("Scan the QR code with an authenticator app (for example Microsoft Authenticator).") }}</li>
    <li>{{ _("Enter the six-digit code shown in the app.") }}</li>
  </ol>
  <div class="qr" role="img" aria-label="{{ _('QR code for the authenticator app') }}">{{ qr_svg|safe }}</div>
  <p>{{ _("Cannot scan? Enter this key:") }} <code class="mono secret">{{ secret }}</code></p>
  <form method="post" action="/account/tweestaps" class="stack">
    {{ csrf() }}
    <div class="field">
      <label for="code">{{ _("Code") }}</label>
      <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" required maxlength="8" class="code-input" autofocus>
    </div>
    <button type="submit" class="button">{{ _("Enable") }}</button>
  </form>
</div>
{% endblock %}
