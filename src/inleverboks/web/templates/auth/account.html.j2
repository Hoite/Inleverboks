{% extends "base.html.j2" %}
{% from "_macros.html.j2" import csrf, errors_box, ok_box with context %}
{% block title %}{{ _("Account") }} · {{ app_name }}{% endblock %}
{% block content %}
<h1>{{ _("Account") }}</h1>
{% if ok == "password" %}{{ ok_box(_("Your password has been changed.")) }}{% endif %}
{% if ok == "totp_disabled" %}{{ ok_box(_("Two-step verification has been disabled.")) }}{% endif %}
{% if ok == "name" %}{{ ok_box(_("Your name has been changed.")) }}{% endif %}
{{ errors_box(errors) }}
<dl class="details">
  <dt>{{ _("E-mail address") }}</dt><dd>{{ current_user.email }}</dd>
  <dt>{{ _("Role") }}</dt><dd>{{ _("Admin") if current_user.is_admin else _("Teacher") }}</dd>
</dl>

<section class="card">
  <h2>{{ _("Name") }}</h2>
  <form method="post" action="/account/naam" class="row-form">
    {{ csrf() }}
    <div class="field grow">
      <label for="account-name">{{ _("Your name") }}</label>
      <input id="account-name" name="name" type="text" required maxlength="200" autocomplete="name" value="{{ name_value }}" aria-describedby="account-name-hint">
      <p class="hint" id="account-name-hint">{{ _("Colleagues see this name, for example when they choose a second reviewer. You log in with your e-mail address.") }}</p>
    </div>
    <button type="submit" class="button button-secondary">{{ _("Save name") }}</button>
  </form>
</section>

<section class="card">
  <h2>{{ _("Education teams") }}</h2>
  {% if my_teams %}
  <ul class="plain-list">
    {% for t in my_teams %}<li><a href="/examens/teams/{{ t.team_id }}">{{ t.name }}</a>{% if t.is_contact %} <span class="badge badge-tcp">{% include "_tcp_mark.html.j2" %}{{ _("Team contact") }}</span>{% endif %}</li>{% endfor %}
  </ul>
  {% else %}
  <p class="muted">{{ _("You are not in an education team yet. Ask an admin or the team contact of your team.") }}</p>
  {% endif %}
</section>

<section class="card">
  <h2>{{ _("Password") }}</h2>
  <p><a class="button button-secondary" href="/account/wachtwoord">{{ _("Change password") }}</a></p>
</section>

<section class="card">
  <h2>{{ _("Two-step verification") }}</h2>
  {% if current_user.totp_enabled %}
  <p><span class="badge badge-success"><span aria-hidden="true">✓</span> {{ _("Enabled") }}</span></p>
  <form method="post" action="/account/herstelcodes" class="inline-form">
    {{ csrf() }}
    <button type="submit" class="button button-secondary">{{ _("New recovery codes") }}</button>
  </form>
  {% if not totp_required %}
  <form method="post" action="/account/tweestaps/uit" class="stack top-gap">
    {{ csrf() }}
    <div class="field">
      <label for="disable-password">{{ _("Password (to disable)") }}</label>
      <input id="disable-password" name="password" type="password" autocomplete="current-password" required>
    </div>
    <button type="submit" class="button button-danger">{{ _("Disable two-step verification") }}</button>
  </form>
  {% endif %}
  {% else %}
  <p><span class="badge badge-neutral">{{ _("Not enabled") }}</span></p>
  <p><a class="button" href="/account/tweestaps">{{ _("Set up two-step verification") }}</a></p>
  {% endif %}
</section>
{% endblock %}
