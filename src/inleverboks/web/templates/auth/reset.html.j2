{% extends "base.html.j2" %}
{% from "_macros.html.j2" import csrf, errors_box with context %}
{% block title %}{{ _("New password") }} · {{ app_name }}{% endblock %}
{% block content %}
<div class="narrow">
  <h1>{{ _("New password") }}</h1>
  {% if email %}<p>{{ email }}</p>{% endif %}
  {{ errors_box(errors) }}
  <form method="post" action="/reset/{{ token }}" class="stack">
    {{ csrf() }}
    <div class="field">
      <label for="password">{{ _("New password") }}</label>
      <input id="password" name="password" type="password" autocomplete="new-password" required minlength="{{ min_length }}" aria-describedby="password-hint" autofocus>
      <p class="hint" id="password-hint">{{ _("At least %(n)s characters. Avoid common passwords.", n=min_length) }}</p>
    </div>
    <div class="field">
      <label for="confirm">{{ _("Repeat new password") }}</label>
      <input id="confirm" name="confirm" type="password" autocomplete="new-password" required minlength="{{ min_length }}">
    </div>
    <button type="submit" class="button">{{ _("Save") }}</button>
  </form>
</div>
{% endblock %}
