{% extends "base.html.j2" %}
{% from "_macros.html.j2" import csrf, errors_box with context %}
{% block title %}{{ _("Teacher login") }} · {{ app_name }}{% endblock %}
{% block content %}
<div class="narrow">
  <h1>{{ _("Teacher login") }}</h1>
  {{ errors_box(errors) }}
  <form method="post" action="/login" class="stack">
    {{ csrf() }}
    <input type="hidden" name="next" value="{{ next }}">
    <div class="field">
      <label for="email">{{ _("E-mail address") }}</label>
      <input id="email" name="email" type="email" autocomplete="username" required value="{{ email }}" autofocus>
    </div>
    <div class="field">
      <label for="password">{{ _("Password") }}</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
    </div>
    <button type="submit" class="button">{{ _("Log in") }}</button>
  </form>
  <p class="muted">{{ _("Forgot your password? Ask the admin for a reset link.") }}</p>
</div>
{% endblock %}
