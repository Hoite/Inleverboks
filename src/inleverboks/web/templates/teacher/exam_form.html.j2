{% extends "base.html.j2" %}
{% from "_macros.html.j2" import csrf with context %}
{% macro err(name) %}{% if problems.get(name) %}<p class="field-error" id="{{ name }}-error"><span aria-hidden="true">!</span> {{ field_messages.get(problems[name], problems[name]) }}</p>{% endif %}{% endmacro %}
{% macro invalid(name) %}{% if problems.get(name) %} aria-invalid="true" aria-describedby="{{ name }}-error"{% endif %}{% endmacro %}
{% block title %}{{ _("Edit exam") if exam else _("New exam") }} · {{ app_name }}{% endblock %}
{% block content %}
<h1>{{ _("Edit exam") if exam else _("New exam") }}</h1>
{% if problems %}
<div class="alert alert-error" role="alert"><span class="alert-icon" aria-hidden="true">!</span><div><p>{{ _("Check the marked fields.") }}</p></div></div>
{% endif %}
{% if locked %}
<div class="alert alert-warning" role="status"><span class="alert-icon" aria-hidden="true">!</span>
  <div><p>{{ _("Students have handed in. The file requirements can no longer be changed.") }}</p></div></div>
{% endif %}

<form method="post" action="{{ '/docent/examens/%s/bewerken'|format(exam.id) if exam else '/docent/examens/nieuw' }}" class="exam-form" novalidate>
  {{ csrf() }}
  {# Enter in a text field triggers the first submit button: make that "save". #}
  <button type="submit" name="action" value="save" class="visually-hidden" tabindex="-1" aria-hidden="true">{{ _("Save") }}</button>
  <input type="hidden" name="source_template_id" value="{{ values.source_template_id }}">

  <fieldset>
    <legend>{{ _("Exam") }}</legend>
    <div class="field">
      <label for="name">{{ _("Name") }}</label>
      <input id="name" name="name" type="text" required maxlength="200" value="{{ values.name }}"{{ invalid("name") }} autofocus>
      {{ err("name") }}
    </div>
    <div class="field">
      <label for="description">{{ _("Description (optional)") }}</label>
      <input id="description" name="description" type="text" maxlength="500" value="{{ values.description }}"{{ invalid("description") }}>
      {{ err("description") }}
    </div>
    <div class="grid-2">
      <div class="field">
        <label for="starts_at">{{ _("Start") }}</label>
        <input id="starts_at" name="starts_at" type="datetime-local" required value="{{ values.starts_at }}"{{ invalid("starts_at") }}>
        {{ err("starts_at") }}
      </div>
      <div class="field">
        <label for="ends_at">{{ _("End") }}</label>
        <input id="ends_at" name="ends_at" type="datetime-local" required value="{{ values.ends_at }}"{{ invalid("ends_at") }}>
        {{ err("ends_at") }}
      </div>
    </div>
    <div class="field">
      <label for="second_reviewer_id">{{ _("Second reviewer (optional)") }}</label>
      <select id="second_reviewer_id" name="second_reviewer_id"{{ invalid("second_reviewer_id") }}>
        <option value="">{{ _("None") }}</option>
        {% for t in teachers %}<option value="{{ t.id }}"{% if values.second_reviewer_id == t.id|string %} selected{% endif %}>{{ t.name }} ({{ t.email }})</option>{% endfor %}
      </select>
      {{ err("second_reviewer_id") }}
    </div>
    <div class="field">
      <label for="slug">{{ _("Link name") }}</label>
      <div class="input-prefix"><span class="mono" aria-hidden="true">{{ base_url }}/</span>
        <input id="slug" name="slug" type="text" maxlength="80" class="mono" value="{{ values.slug }}" aria-describedby="slug-hint{% if problems.get('slug') %} slug-error{% endif %}"{% if problems.get('slug') %} aria-invalid="true"{% endif %} autocomplete="off">
      </div>
      <p class="hint" id="slug-hint">{{ _("Leave empty to derive it from the name. a-z, 0-9 and dashes.") }}</p>
      {{ err("slug") }}
    </div>
  </fieldset>

  <fieldset{% if locked %} disabled{% endif %}>
    <legend>{{ _("Expected files") }}</legend>
    <input type="hidden" name="slot_count" value="{{ values.slots|length }}">
    {{ err("slots") }}
    {% for slot in values.slots %}
    {% set i = loop.index0 %}
    <div class="slot-row">
      <input type="hidden" name="slot_id_{{ i }}" value="{{ slot.id }}">
      <div class="field">
        <label for="slot_label_{{ i }}">{{ _("Label of file %(n)s", n=loop.index) }}</label>
        <input id="slot_label_{{ i }}" name="slot_label_{{ i }}" type="text" maxlength="100" value="{{ slot.label }}" placeholder="{{ _('e.g. Report') }}"{{ invalid("slot_%d_label"|format(i)) }}>
        {{ err("slot_%d_label"|format(i)) }}
      </div>
      <div class="field">
        <label for="slot_pattern_{{ i }}">{{ _("Expected file name (optional)") }}</label>
        <input id="slot_pattern_{{ i }}" name="slot_pattern_{{ i }}" type="text" maxlength="255" class="mono" value="{{ slot.pattern }}" placeholder="Examen_Linux_P3_*.docx"{{ invalid("slot_%d_pattern"|format(i)) }}>
        {{ err("slot_%d_pattern"|format(i)) }}
      </div>
      <div class="field">
        <label for="slot_extensions_{{ i }}">{{ _("Extensions (optional)") }}</label>
        <input id="slot_extensions_{{ i }}" name="slot_extensions_{{ i }}" type="text" maxlength="200" class="mono" value="{{ slot.extensions }}" placeholder="docx"{{ invalid("slot_%d_extensions"|format(i)) }}>
        {{ err("slot_%d_extensions"|format(i)) }}
      </div>
      <div class="slot-actions">
        <button type="submit" name="action" value="remove_slot:{{ i }}" class="button button-small button-secondary" formnovalidate>{{ _("Remove") }}<span class="visually-hidden"> {{ _("file %(n)s", n=loop.index) }}</span></button>
      </div>
    </div>
    {% endfor %}
    <p><button type="submit" name="action" value="add_slot" class="button button-small button-secondary" formnovalidate>{{ _("Add expected file") }}</button></p>
    <p class="hint">{{ _("Use * as wildcard in the expected name. Template files can be uploaded on the exam page after saving.") }}</p>
    <label class="checkbox"><input type="checkbox" name="allow_extra_file" value="true"{% if values.allow_extra_file %} checked{% endif %}> {{ _("Allow extra files") }}</label>
    <div class="field">
      <label for="extensions">{{ _("Allowed extensions") }}</label>
      <textarea id="extensions" name="extensions" rows="2" class="mono"{{ invalid("extensions") }}>{{ values.extensions }}</textarea>
      {{ err("extensions") }}
    </div>
    <div class="grid-2">
      <div class="field">
        <label for="max_file_mb">{{ _("Maximum per file (MB)") }}</label>
        <input id="max_file_mb" name="max_file_mb" type="number" min="1" max="{{ env.max_file_mb }}" value="{{ values.max_file_mb }}"{{ invalid("max_file_mb") }}>
        {{ err("max_file_mb") }}
      </div>
      <div class="field">
        <label for="max_submission_mb">{{ _("Maximum per submission (MB)") }}</label>
        <input id="max_submission_mb" name="max_submission_mb" type="number" min="1" max="{{ env.max_submission_mb }}" value="{{ values.max_submission_mb }}"{{ invalid("max_submission_mb") }}>
        {{ err("max_submission_mb") }}
      </div>
    </div>
  </fieldset>
  {% if locked %}
  {# Disabled fieldsets are not submitted; send the locked values along. #}
  <input type="hidden" name="slot_count" value="{{ values.slots|length }}">
  {% for slot in values.slots %}
  <input type="hidden" name="slot_id_{{ loop.index0 }}" value="{{ slot.id }}">
  <input type="hidden" name="slot_label_{{ loop.index0 }}" value="{{ slot.label }}">
  <input type="hidden" name="slot_pattern_{{ loop.index0 }}" value="{{ slot.pattern }}">
  <input type="hidden" name="slot_extensions_{{ loop.index0 }}" value="{{ slot.extensions }}">
  {% endfor %}
  <input type="hidden" name="extensions" value="{{ values.extensions }}">
  <input type="hidden" name="max_file_mb" value="{{ values.max_file_mb }}">
  <input type="hidden" name="max_submission_mb" value="{{ values.max_submission_mb }}">
  {% if values.allow_extra_file %}<input type="hidden" name="allow_extra_file" value="true">{% endif %}
  {% endif %}

  <fieldset>
    <legend>{{ _("Access") }}</legend>
    <label class="checkbox"><input type="checkbox" name="access_code_enabled" value="true"{% if values.access_code_enabled %} checked{% endif %}> {{ _("Access code required") }}</label>
    <label class="checkbox"><input type="checkbox" name="ip_restriction_enabled" value="true"{% if values.ip_restriction_enabled %} checked{% endif %}> {{ _("Only allow certain IP addresses") }}</label>
    <div class="grid-2">
      <div class="field">
        <label for="ip_preset_id">{{ _("IP preset") }}</label>
        <select id="ip_preset_id" name="ip_preset_id"{{ invalid("ip_preset_id") }}>
          <option value="">{{ _("None") }}</option>
          {% for p in presets %}<option value="{{ p.id }}"{% if values.ip_preset_id == p.id|string %} selected{% endif %}>{{ p.name }}</option>{% endfor %}
        </select>
        {{ err("ip_preset_id") }}
      </div>
      <div class="field">
        <label for="ip_cidrs">{{ _("Other IP ranges") }}</label>
        <textarea id="ip_cidrs" name="ip_cidrs" rows="2" class="mono" placeholder="10.20.0.0/16"{{ invalid("ip_cidrs") }}>{{ values.ip_cidrs }}</textarea>
        {{ err("ip_cidrs") }}
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{ _("Students") }}</legend>
    {% if not exam %}
    <div class="field">
      <label for="class_list_id">{{ _("Class list (optional)") }}</label>
      <select id="class_list_id" name="class_list_id"{{ invalid("class_list_id") }}>
        <option value="">{{ _("No class list") }}</option>
        {% for cl in class_lists %}<option value="{{ cl.id }}"{% if values.class_list_id == cl.id|string %} selected{% endif %}>{{ cl.name }} ({{ cl.entries|length }})</option>{% endfor %}
      </select>
      {{ err("class_list_id") }}
    </div>
    {% endif %}
    <label class="checkbox"><input type="checkbox" name="allow_unlisted" value="true"{% if values.allow_unlisted %} checked{% endif %}> {{ _("Allow students who are not on the class list") }}</label>
  </fieldset>

  <div class="form-actions">
    <button type="submit" name="action" value="save" class="button">{{ _("Save") }}</button>
    <a class="button button-secondary" href="{{ '/docent/examens/%s/instellingen'|format(exam.id) if exam else '/docent' }}">{{ _("Cancel") }}</a>
  </div>
</form>
{% endblock %}
