{% extends "base.html.j2" %}
{% block title %}{{ _("Audit log") }} · {{ exam.name }} · {{ app_name }}{% endblock %}
{% block content %}
<p class="breadcrumb"><a href="/docent">{{ _("Exams") }}</a></p>
<h1>{{ exam.name }}</h1>
{% set exam_tab = "audit" %}{% include "teacher/_exam_tabs.html.j2" %}
{% if chain_ok %}
<p><span class="badge badge-success"><span aria-hidden="true">✓</span> {{ _("Hash chain intact") }}</span> <span class="muted">{{ _("%(n)s events", n=total) }}</span></p>
{% else %}
<div class="alert alert-error" role="alert"><span class="alert-icon" aria-hidden="true">!</span><div><p>{{ _("The hash chain of this log is broken. Report this to the admin.") }}</p></div></div>
{% endif %}
<form method="get" action="/docent/examens/{{ exam.id }}/auditlog" class="row-form">
  <div class="field grow">
    <label for="event">{{ _("Filter on event") }}</label>
    <input id="event" name="event" type="text" value="{{ event_filter }}" placeholder="submission" autocomplete="off">
  </div>
  <div class="field grow">
    <label for="actor">{{ _("Filter on actor") }}</label>
    <input id="actor" name="actor" type="text" value="{{ actor_filter }}" autocomplete="off">
  </div>
  <button type="submit" class="button button-secondary">{{ _("Filter") }}</button>
  <a class="button button-secondary" href="/docent/examens/{{ exam.id }}/auditlog?format=csv&amp;event={{ event_filter|urlencode }}&amp;actor={{ actor_filter|urlencode }}">{{ _("Export CSV") }}</a>
  <a class="button button-secondary" href="/docent/examens/{{ exam.id }}/auditlog?format=pdf&amp;event={{ event_filter|urlencode }}&amp;actor={{ actor_filter|urlencode }}">{{ _("Export PDF") }}</a>
</form>
<div class="table-wrap">
<table class="audit-table">
  <thead><tr><th scope="col">#</th><th scope="col">{{ _("Time") }}</th><th scope="col">{{ _("Actor") }}</th><th scope="col">{{ _("IP address") }}</th><th scope="col">{{ _("Event") }}</th><th scope="col">{{ _("Details") }}</th></tr></thead>
  <tbody>
  {% for e in events %}
    <tr>
      <td>{{ e.seq }}</td>
      <td>{{ e.ts|localtime("%d-%m-%Y %H:%M:%S") }}</td>
      <td>{{ e.actor_label }}</td>
      <td class="mono">{{ e.ip or "" }}</td>
      <td class="mono">{{ e.event }}</td>
      <td class="mono small">{{ e.details|tojson }}</td>
    </tr>
  {% else %}
    <tr><td colspan="6" class="muted">{{ _("No events.") }}</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% if total > events|length %}<p class="muted">{{ _("Showing the latest %(n)s events. Export for the complete log.", n=events|length) }}</p>{% endif %}
{% endblock %}
