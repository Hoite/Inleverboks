<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false, "allowEval": false, "allowScriptTags": false}'>
  <title>{{ exam.name }} · {{ app_name }}</title>
  <link rel="stylesheet" href="{{ asset('css/app.css') }}">
  <link rel="stylesheet" href="/huisstijl/stijl.css?v={{ brand.version }}">
  <link rel="icon" href="{{ '/huisstijl/favicon.png?v=' ~ brand.version if brand.favicon else asset('img/favicon.svg') }}" type="{{ 'image/png' if brand.favicon else 'image/svg+xml' }}">
  <script src="{{ asset('vendor/htmx/htmx.min.js') }}" defer></script>
  <script type="module" src="{{ asset('js/presentation.js') }}"></script>
</head>
<body class="presentation">
  <main class="present" data-server-now="{{ server_now_ms }}" data-start="{{ start_ms }}" data-end="{{ end_ms }}">
    <h1 class="present-title">{{ exam.name }}</h1>
    <div class="present-grid">
      <div class="present-qr" role="img" aria-label="{{ _('QR code of the hand-in link') }}">{{ qr_svg|safe }}</div>
      <div class="present-info">
        <p class="present-label">{{ _("Go to") }}</p>
        <p class="present-url mono">{{ short_url }}</p>
        {% if exam.access_code_enabled %}
        <p class="present-label">{{ _("Access code") }}</p>
        <p class="present-code mono">{{ exam.access_code }}</p>
        {% endif %}
        <p class="present-label">{{ _("Time remaining") }}</p>
        <p class="present-time mono" id="countdown"
           data-before="{{ _('Opens in') }}" data-closed="{{ _('Closed') }}">–</p>
        {% include "teacher/_counter.html.j2" %}
      </div>
    </div>
    <p class="present-exit"><a href="/examens/{{ exam.id }}">{{ _("Leave presentation mode") }}</a></p>
  </main>
</body>
</html>
