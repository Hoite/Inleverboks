{% extends "base.html.j2" %}
{% from "_macros.html.j2" import csrf, errors_box with context %}
{% block title %}{% if target %}{{ _("Replace class list") }}{% else %}{{ _("Import class list") }}{% endif %} · {{ app_name }}{% endblock %}
{% block content %}
<p class="breadcrumb"><a href="/examens/klassenlijsten">{{ _("Class lists") }}</a>{% if target %} › <a href="/examens/klassenlijsten/{{ target.id }}">{{ target.name }}</a>{% endif %}</p>
<div class="narrow">
  <h1>{% if target %}{{ _("Replace class list") }}{% else %}{{ _("Import class list") }}{% endif %}</h1>
{% if target %}<p>{{ _("The new file replaces all students of this list. Exams that already use the list keep their own copy.") }}</p>{% endif %}
  {{ errors_box(errors) }}
  <form method="post" action="/examens/klassenlijsten/nieuw" enctype="multipart/form-data" class="stack">
    {{ csrf() }}
    {% if target %}<input type="hidden" name="replace_id" value="{{ target.id }}">{% endif %}
    <div class="field">
      <label for="name">{{ _("Name") }}</label>
      <input id="name" name="name" type="text" maxlength="200" value="{{ name }}" placeholder="{{ _('e.g. ICT-2A 2026') }}">
    </div>
    <div class="field">
      <label for="file">{{ _("CSV file") }}</label>
      <input id="file" name="file" type="file" accept=".csv,text/csv" required aria-describedby="file-hint">
      <p class="hint" id="file-hint">{{ _("Separated by ; or , in UTF-8 or Windows-1252. You choose the columns in the next step.") }}</p>
    </div>
    <button type="submit" class="button">{{ _("Next") }}</button>
  </form>
</div>
{% endblock %}
