{% extends "base.html.j2" %}
{% from "teacher/_status.html.j2" import status_badge %}
{% block head_extra %}{% if owners is defined %}<script type="module" src="{{ asset('js/combobox.js') }}"></script>{% endif %}{% endblock %}
{% block title %}{{ _("Exams") }} · {{ app_name }}{% endblock %}
{% block content %}
<div class="page-head">
  <h1>{{ _("Exams") }}</h1>
  <a class="button" href="/examens/nieuw">{{ _("New exam") }}</a>
</div>
{% include "teacher/_tabs.html.j2" %}
{% if ok is defined and ok == "deleted" %}<div class="alert alert-success" role="status"><span class="alert-icon" aria-hidden="true">✓</span><div><p>{{ _("The exam has been deleted permanently.") }}</p></div></div>{% endif %}
{% set show_owner = owner_names is defined and owner_names is not none %}
{% if owners is defined %}
<form method="get" action="/examens/alle" class="row-form filter-form">
  <div class="field">
    <label for="eigenaar">{{ _("Owner") }}</label>
    <select id="eigenaar" name="eigenaar" data-combobox data-config="{{ combobox_config() }}">
      <option value="">{{ _("All teachers") }}</option>
      {% for uid, name in owners %}<option value="{{ uid }}"{% if owner_filter == uid %} selected{% endif %}>{{ name }}</option>{% endfor %}
    </select>
  </div>
  <button type="submit" class="button button-secondary">{{ _("Filter") }}</button>
</form>
{% endif %}
{% if rows %}
<div class="table-wrap">
<table>
  <thead>
    <tr>
      <th scope="col">{{ _("Exam") }}</th>
      {% if show_owner %}<th scope="col">{{ _("Owner") }}</th>{% endif %}
      <th scope="col">{{ _("Status") }}</th>
      <th scope="col">{{ _("Start") }}</th>
      <th scope="col">{{ _("End") }}</th>
      <th scope="col">{{ _("Handed in") }}</th>
      <th scope="col">{{ _("Link") }}</th>
    </tr>
  </thead>
  <tbody>
  {% for row in rows %}
    <tr>
      <td><a href="/examens/{{ row.exam.id }}">{{ row.exam.name }}</a>
        {% if row.retention.warning(now) %}<br><a class="signal" href="/examens/{{ row.exam.id }}/geavanceerd#bewaartermijn"><span aria-hidden="true">!</span> {{ _("Files are deleted on %(d)s", d=row.retention.due|localtime("%d-%m-%Y")) }}</a>{% endif %}
        {% if row.retention.held %}<br><span class="signal signal-extension"><span aria-hidden="true">i</span> {{ _("Retention hold") }}</span>{% endif %}</td>
      {% if show_owner %}<td>{% if row.exam.owner_id == current_user.id %}{{ _("You") }}{% else %}{{ owner_names.get(row.exam.owner_id, "") }}{% endif %}</td>{% endif %}
      <td>{{ status_badge(row.status, status_labels) }}</td>
      <td>{{ row.exam.starts_at|localtime }}</td>
      <td>{{ row.exam.ends_at|localtime }}</td>
      <td>{{ row.submissions }}</td>
      <td class="mono small">/{{ row.exam.slug }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p class="muted">{{ _("No exams yet.") }}</p>
{% endif %}
{% endblock %}
