{% extends "base.html.j2" %}
{% from "_macros.html.j2" import csrf, errors_box, ok_box with context %}
{% from "teacher/_status.html.j2" import status_badge %}
{% block title %}{{ exam.name }} · {{ app_name }}{% endblock %}
{% block content %}
<p class="breadcrumb"><a href="/examens">{{ _("Exams") }}</a></p>
<div class="page-head">
  <div>
    <h1>{{ exam.name }}</h1>
    <p>{{ status_badge(exam_status, status_labels) }} <span class="muted">{{ exam.starts_at|localtime }} – {{ exam.ends_at|localtime("%H:%M") }}</span></p>
    {% if exam.qualification %}<p class="muted small"><span class="mono">{{ exam.qualification.crebo }}</span> {{ exam.qualification.name }}{% if exam.qualification.core_task_code %} · <span class="mono">{{ exam.qualification.core_task_code }}</span>{% endif %}</p>{% endif %}
  </div>
  <div class="button-row">
    <a class="button button-secondary" href="/examens/{{ exam.id }}/presentatie">{{ _("Presentation mode") }}</a>
    <a class="button button-secondary" href="/examens/{{ exam.id }}/instellingen#link">{{ _("Link and QR code") }}</a>
  </div>
</div>
{% set exam_tab = "overview" %}{% include "teacher/_exam_tabs.html.j2" %}
{% set ok_messages = {"hold_set": _("The retention hold is set. Files will not be deleted."), "hold_removed": _("The retention hold has been removed.")} %}
{% if ok and ok in ok_messages %}{{ ok_box(ok_messages[ok]) }}{% endif %}
{{ errors_box(error) }}
{% if exam.finalized_at %}
<div class="alert alert-warning" role="status"><span class="alert-icon" aria-hidden="true">i</span>
  <div><p>{{ _("This exam is finalized: the handed-in files were deleted on %(d)s. The proces-verbaal and the audit log remain.", d=exam.finalized_at|localtime("%d-%m-%Y")) }}</p></div></div>
{% elif retention.warning(now) %}
<div class="alert alert-warning" role="status"><span class="alert-icon" aria-hidden="true">!</span>
  <div><p>{{ _("The handed-in files will be deleted on %(d)s.", d=retention.due|localtime("%d-%m-%Y %H:%M")) }}</p></div></div>
{% endif %}

<ul class="counters" aria-label="{{ _('Counters') }}">
  <li><span class="counter-value">{{ data.counters.active }}</span> {{ _("handed in") }}</li>
  {% if data.has_roster %}<li><span class="counter-value">{{ data.counters.missing }}</span> {{ _("not handed in yet") }}</li>{% endif %}
  <li><span class="counter-value">{{ data.counters.cancelled }}</span> {{ _("cancelled") }}</li>
  <li><span class="counter-value">{{ data.counters.invalid }}</span> {{ _("invalid") }}</li>
  {% if data.has_roster %}<li><span class="counter-value">{{ data.counters.not_on_list }}</span> {{ _("not on list") }}</li>{% endif %}
</ul>

<form method="get" action="/examens/{{ exam.id }}" class="row-form filter-form">
  <div class="field">
    <label for="status">{{ _("Show") }}</label>
    <select id="status" name="status">
      <option value="">{{ _("All") }}</option>
      {% for value, label in [("active", _("Handed in")), ("missing", _("Not handed in yet")), ("cancelled", _("Cancelled")), ("invalid", _("Invalid")), ("not_on_list", _("Not on list"))] %}
      {% if data.has_roster or value not in ("missing", "not_on_list") %}
      <option value="{{ value }}"{% if status_filter == value %} selected{% endif %}>{{ label }}</option>
      {% endif %}
      {% endfor %}
    </select>
  </div>
  <div class="field">
    <label for="sort">{{ _("Sort by") }}</label>
    <select id="sort" name="sort">
      {% for value, label in [("name", _("Name")), ("number", _("Student number")), ("time", _("Handed in at")), ("status", _("Status")), ("size", _("Size"))] %}
      <option value="{{ value }}"{% if sort == value %} selected{% endif %}>{{ label }}</option>
      {% endfor %}
    </select>
  </div>
  <label class="checkbox"><input type="checkbox" name="desc" value="true"{% if desc %} checked{% endif %}> {{ _("Descending") }}</label>
  <button type="submit" class="button button-secondary">{{ _("Apply") }}</button>
</form>

{% include "teacher/_overview_table.html.j2" %}

<section class="card">
  <h2>{{ _("Downloads and exports") }}</h2>
  {% if perms.download_files and not exam.finalized_at %}
  <form method="get" action="/examens/{{ exam.id }}/zip" class="row-form">
    <label class="checkbox"><input type="checkbox" name="geannuleerd" value="true"> {{ _("Include cancelled attempts") }}</label>
    <label class="checkbox"><input type="checkbox" name="ongeldig" value="true"> {{ _("Include invalid attempts") }}</label>
    <button type="submit" class="button">{{ _("Download all (zip)") }}</button>
  </form>
  {% endif %}
  <div class="button-row top-gap">
    {% if perms.export %}
    <a class="button button-secondary" href="/examens/{{ exam.id }}/overzicht.csv">{{ _("Export CSV") }}</a>
    <form method="post" action="/examens/{{ exam.id }}/proces-verbaal" class="inline-form">
      {{ csrf() }}<button type="submit" class="button button-secondary">{{ _("Proces-verbaal (PDF)") }}</button>
    </form>
    {% endif %}
    <a class="button button-secondary" href="/examens/{{ exam.id }}/auditlog">{{ _("Audit log") }}</a>
    {% if perms.duplicate %}<a class="button button-secondary" href="/examens/{{ exam.id }}/herkansing">{{ _("Resit for several students") }}</a>{% endif %}
  </div>
</section>
{% if proces_verbalen and perms.export %}
<section class="card">
  <h2>{{ _("Proces-verbalen") }}</h2>
  <ul>
  {% for pv in proces_verbalen %}
    <li><a href="/examens/{{ exam.id }}/proces-verbalen/{{ pv.id }}">{{ pv.document_id }}</a>
      <span class="muted">· {{ pv.generated_at|localtime }}</span>{% if pv.is_final %} <strong>{{ _("final") }}</strong>{% endif %}</li>
  {% endfor %}
  </ul>
</section>
{% endif %}

<section class="card" id="bewaartermijn">
  <h2>{{ _("Retention") }}</h2>
  {% if exam.finalized_at %}
    <p>{{ _("Files deleted on %(d)s.", d=exam.finalized_at|localtime("%d-%m-%Y %H:%M")) }}</p>
  {% elif retention.held %}
    <p><span class="signal signal-extension"><span aria-hidden="true">i</span> {{ _("Retention hold") }}</span> {{ exam.hold_reason }}</p>
  {% elif retention.due %}
    <p>{{ _("The handed-in files will be deleted on %(d)s.", d=retention.due|localtime("%d-%m-%Y %H:%M")) }}</p>
  {% else %}
    <p class="muted">{{ _("The retention period starts when the exam is published and closed.") }}</p>
  {% endif %}
  {% if perms.set_hold and not exam.finalized_at %}
  <form method="post" action="/examens/{{ exam.id }}/bewaren" class="row-form">
    {{ csrf() }}
    {% if exam.hold %}<input type="hidden" name="remove" value="true">{% endif %}
    <div class="field grow">
      <label for="hold-reason">{{ _("Reason") }}</label>
      <input id="hold-reason" name="reason" type="text" required maxlength="1000" placeholder="{{ _('e.g. objection or appeal') }}">
    </div>
    <button type="submit" class="button button-secondary">{{ _("Remove retention hold") if exam.hold else _("Set retention hold") }}</button>
  </form>
  {% endif %}
  {% if perms.delete_finalized and exam.finalized_at %}
  <form method="post" action="/examens/{{ exam.id }}/definitief-verwijderen" class="row-form top-gap">
    {{ csrf() }}
    <div class="field grow">
      <label for="delete-reason">{{ _("Reason for permanent deletion") }}</label>
      <input id="delete-reason" name="reason" type="text" required maxlength="1000">
    </div>
    <button type="submit" class="button button-danger">{{ _("Delete exam permanently") }}</button>
  </form>
  {% endif %}
</section>
{% endblock %}
