{% extends "base.html.j2" %}
{% from "_macros.html.j2" import ok_box with context %}
{% from "teacher/_template_badge.html.j2" import template_badge %}
{% block title %}{{ _("Exam templates") }} · {{ app_name }}{% endblock %}
{% block content %}
<div class="page-head">
  <h1>{{ _("Exams") }}</h1>
  <div class="button-row">
    <a class="button" href="/docent/examens/nieuw">{{ _("New exam") }}</a>
    <a class="button button-template" href="/docent/sjablonen/nieuw">{{ _("New template") }}</a>
  </div>
</div>
{% include "teacher/_tabs.html.j2" %}
{% if ok == "deleted" %}{{ ok_box(_("The template has been deleted.")) }}{% endif %}
<p class="hint">{{ _("A template holds the expected files, template files, extensions, limits and access settings. Times, link name and class list are chosen per exam.") }}</p>
{% if templates %}
<ul class="template-list">
  {% for t in templates %}
  <li class="template-card">
    <div class="template-card-head">
      {{ template_badge(_("Template")) }}
      <h2><a href="/docent/sjablonen/{{ t.id }}">{{ t.name }}</a></h2>
    </div>
    <p class="muted small">
      {% if t.slots %}{{ t.slots|map(attribute="label")|join(", ") }}{% else %}{{ _("No expected files") }}{% endif %}
      · <span class="mono">{{ (t.config.get("extensions") or [])|join(", ") }}</span>
    </p>
    <div class="button-row">
      <a class="button button-small" href="/docent/examens/nieuw?sjabloon={{ t.id }}">{{ _("New exam") }}<span class="visually-hidden"> {{ _("from %(name)s", name=t.name) }}</span></a>
      <a class="button button-small button-secondary" href="/docent/sjablonen/{{ t.id }}/bewerken">{{ _("Edit") }}<span class="visually-hidden"> {{ t.name }}</span></a>
    </div>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="muted">{{ _("No exam templates yet. Create one here, or save an existing exam as template from its settings page.") }}</p>
{% endif %}
{% endblock %}
