{% extends "base.html.j2" %}
{% from "_macros.html.j2" import ok_box with context %}
{% from "teacher/_template_badge.html.j2" import template_badge %}
{% from "teacher/_view_switch.html.j2" import view_switch %}
{% block title %}{{ _("Exam templates") }} · {{ app_name }}{% endblock %}
{% macro card(t) %}
  <li class="template-card{% if t.shared or t.team_id %} template-card-shared{% endif %}">
    <div class="template-card-head">
      <span class="badge-row">{{ template_badge(_("Template")) }}{% if t.shared %} <span class="badge badge-neutral">{{ _("Shared") }}</span>{% endif %}{% if t.team_id %} <span class="badge badge-neutral">{{ team_names.get(t.team_id, "") }}</span>{% endif %}{% if t.id in outdated %} <span class="badge badge-warning"><span aria-hidden="true">!</span> {{ _("Dossier replaced") }}</span>{% endif %}</span>
      <h3><a href="/examens/sjablonen/{{ t.id }}">{{ t.name }}</a></h3>
    </div>
    <p class="muted small">
      {% if t.slots %}{{ t.slots|length }} {{ _("expected files") }}{% else %}{{ _("No expected files") }}{% endif %}
      · <span class="mono">{{ (t.config.get("extensions") or [])|join(", ") }}</span>
    </p>
    <div class="button-row">
      <a class="button button-small" href="/examens/nieuw?sjabloon={{ t.id }}">{{ _("New exam") }}<span class="visually-hidden"> {{ _("from %(name)s", name=t.name) }}</span></a>
      <a class="button button-small button-secondary" href="/examens/sjablonen/{{ t.id }}">{{ _("View") }}<span class="visually-hidden"> {{ t.name }}</span></a>
    </div>
  </li>
{% endmacro %}
{% block content %}
<div class="page-head">
  <h1>{{ _("Exams") }}</h1>
  <div class="button-row">
    <a class="button" href="/examens/nieuw">{{ _("New exam") }}</a>
    <a class="button button-template" href="/examens/sjablonen/crebo">{{ _("Template from crebo") }}</a>
    <a class="button button-secondary" href="/examens/sjablonen/nieuw">{{ _("New empty template") }}</a>
  </div>
</div>
{% include "teacher/_tabs.html.j2" %}
{% if ok == "deleted" %}{{ ok_box(_("The template has been deleted.")) }}{% endif %}
{% if ok == "created_from_crebo" %}{{ ok_box(_("Templates created: %(n)s. Upload the template files on each template page.", n=created)) }}{% endif %}
<p class="hint">{{ _("A template holds the expected files, template files, extensions, limits and access settings. Times, link name and class list are chosen per exam.") }}</p>
{% if current_user.is_admin %}{{ view_switch(_("Show templates"), "/examens/sjablonen", everyone, _("Shared and mine"), _("All templates"), admin=true) }}{% endif %}

{% if everyone %}
<section aria-labelledby="all-title">
  <h2 id="all-title">{{ _("All templates") }}</h2>
  <p class="hint">{{ _("Team templates, shared templates and the personal templates of every teacher. You can view another teacher's personal template and copy it to your own templates or to a team; only its owner changes it.") }}</p>
  {% if all_templates %}
  <div class="table-wrap">
  <table>
    <thead><tr><th scope="col">{{ _("Template") }}</th><th scope="col">{{ _("Owner") }}</th><th scope="col">{{ _("Kind") }}</th><th scope="col">{{ _("Expected files") }}</th></tr></thead>
    <tbody>
    {% for t in all_templates %}
      <tr>
        <td><a href="/examens/sjablonen/{{ t.id }}">{{ t.name }}</a>{% if t.id in outdated %} <span class="badge badge-warning"><span aria-hidden="true">!</span> {{ _("Dossier replaced") }}</span>{% endif %}</td>
        <td>{% if t.owner_id == current_user.id %}{{ _("You") }}{% else %}{{ owner_names.get(t.owner_id, "") }}{% endif %}</td>
        <td>{% if t.team_id %}{{ _("Team: %(team)s", team=team_names.get(t.team_id, "")) }}{% elif t.shared %}<span class="badge badge-neutral">{{ _("Shared") }}</span>{% else %}{{ _("Personal") }}{% endif %}</td>
        <td>{{ t.slots|length }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p class="muted">{{ _("No exam templates yet.") }}</p>
  {% endif %}
</section>
{% else %}

{% for team_id, team_name, team_templates, may_manage in team_sections %}
<section aria-labelledby="team-{{ team_id }}">
  <div class="page-head">
    <h2 id="team-{{ team_id }}">{{ _("Team templates: %(team)s", team=team_name) }}</h2>
    {% if may_manage %}<a class="button button-small button-tcp" href="/examens/sjablonen/crebo?team={{ team_id }}">{% include "_tcp_mark.html.j2" %}{{ _("Template from crebo") }}<span class="visually-hidden"> {{ _("for %(team)s", team=team_name) }}</span></a>{% endif %}
  </div>
  {% if team_templates %}
  <ul class="template-list">{% for t in team_templates %}{{ card(t) }}{% endfor %}</ul>
  {% else %}
  <p class="muted">{{ _("This team has no templates yet.") }}{% if may_manage %} {{ _("Create one from a crebo, or copy one of your own templates to the team on its page.") }}{% endif %}</p>
  {% endif %}
</section>
{% endfor %}

{% if shared_templates %}
<section aria-labelledby="shared-title">
  <h2 id="shared-title">{{ _("Shared templates") }}</h2>
  <p class="hint">{{ _("From before the education teams: available to every teacher until an admin assigns them to a team. Make a copy to change one for yourself.") }}</p>
  <ul class="template-list">{% for t in shared_templates %}{{ card(t) }}{% endfor %}</ul>
</section>
{% endif %}

<section aria-labelledby="own-title">
  <h2 id="own-title">{{ _("My templates") }}</h2>
  {% if own_templates %}
  <ul class="template-list">{% for t in own_templates %}{{ card(t) }}{% endfor %}</ul>
  {% else %}
  <p class="muted">{{ _("No exam templates yet. Create one here, or save an existing exam as template on its Advanced tab.") }}</p>
  {% endif %}
</section>
{% endif %}
{% endblock %}
