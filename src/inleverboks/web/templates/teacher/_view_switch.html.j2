{# Two links that switch a list between "mine" and "all" (query param, no JS). #}
{% macro view_switch(label, base, everyone, mine_label, all_label, admin=false) %}
<nav class="view-switch" aria-label="{{ label }}">
  <a href="{{ base }}"{% if not everyone %} aria-current="page"{% endif %}>{{ mine_label }}</a>
  <a href="{{ base }}?toon=alle"{% if admin %} class="admin-tab"{% endif %}{% if everyone %} aria-current="page"{% endif %}>{% if admin %}{% include "_admin_crown.html.j2" %}{% endif %}{{ all_label }}</a>
</nav>
{% endmacro %}
