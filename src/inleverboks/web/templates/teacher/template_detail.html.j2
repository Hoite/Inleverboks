{% extends "base.html.j2" %}
{% from "_macros.html.j2" import csrf, errors_box, ok_box with context %}
{% from "teacher/_template_badge.html.j2" import template_badge %}
{% block body_class %}mode-template{% endblock %}
{% block title %}{{ exam_template.name }} · {{ app_name }}{% endblock %}
{% block content %}
<p class="breadcrumb"><a href="/examens/sjablonen{% if not exam_template.shared and not exam_template.team_id and exam_template.owner_id != current_user.id %}?toon=alle{% endif %}">{{ _("Exam templates") }}</a></p>
<div class="template-banner" role="note">{{ template_badge(_("Exam template")) }}
  <span>{{ _("This is a template, not an exam. Students cannot hand in here; create an exam from the template for that.") }}</span></div>
<div class="page-head">
  <div>
    <h1>{{ exam_template.name }}</h1>
    {% if exam_template.team_id %}<p><span class="badge badge-neutral">{{ _("Team template") }}</span> <span class="muted small">{{ _("Education team %(team)s: available to its members, managed by its team contacts.", team=team_name) }}</span></p>
    {% elif exam_template.shared %}<p><span class="badge badge-neutral">{{ _("Shared") }}</span> <span class="muted small">{{ _("Available to every teacher; managed by the admin.") }}</span></p>
    {% elif exam_template.owner_id != current_user.id %}<p><span class="badge badge-neutral">{{ _("Personal") }}</span> <span class="muted small">{{ _("Owner") }}: {{ owner_name }}. {{ _("Only the owner can change this template.") }}</span></p>{% endif %}
  </div>
  <div class="button-row">
    <a class="button" href="/examens/nieuw?sjabloon={{ exam_template.id }}">{{ _("New exam from this template") }}</a>
    {% if can_manage %}
    <a class="button {{ 'button-tcp' if exam_template.team_id else 'button-secondary' }}" href="/examens/sjablonen/{{ exam_template.id }}/bewerken">{% if exam_template.team_id %}{% include "_tcp_mark.html.j2" %}{% endif %}{{ _("Edit template") }}</a>
    {% endif %}
    <form method="post" action="/examens/sjablonen/{{ exam_template.id }}/kopie" class="inline-form">{{ csrf() }}<button type="submit" class="button button-secondary">{{ _("Make a copy") }}</button></form>
  </div>
</div>
{% set ok_messages = {
  "created": _("The template has been created. Add template files to the expected files if you want."),
  "saved": _("The template has been saved."),
  "saved_from_exam": _("The exam has been saved as a template. You can adjust it here; the exam itself does not change."),
  "template_uploaded": _("Template file uploaded."), "template_removed": _("Template file removed."),
  "copied": _("This is your own copy of the template. You can change it."),
  "copied_team": _("This is a copy of the template for the team. Every member of the team can use it now."),
} %}
{% if ok and ok in ok_messages %}{{ ok_box(ok_messages[ok]) }}{% endif %}
{{ errors_box(errors) }}
{% if dossier %}
{% set q = dossier.qualification %}
{% if dossier.status.outdated %}
<div class="alert alert-warning" role="status"><span class="alert-icon" aria-hidden="true">!</span>
  <div>
    {% if dossier.status.replaced_by %}
    {% set new = dossier.status.replaced_by %}
    {% if new.crebo == q.crebo %}
    <p><strong>{{ _("Dossier replaced") }}:</strong> {{ _("SBB has a newer version (%(v)s) of this qualification. Check the template.", v=new.dossier_version) }}</p>
    {% else %}
    <p><strong>{{ _("Dossier replaced") }}:</strong> {{ _("SBB has replaced this qualification by crebo %(c)s %(name)s (dossier %(v)s). Check the template.", c=new.crebo, name=new.name, v=new.dossier_version) }}</p>
    {% endif %}
    {% if dossier.changes %}
    <ul>
      {% for c in dossier.changes %}
      <li><span class="mono">{{ c.code }}</span>
        {% if c.old is none %}{{ _("new:") }} {{ c.new }}{% elif c.new is none %}{{ _("removed:") }} {{ c.old }}{% else %}{{ c.old }} → {{ c.new }}{% endif %}</li>
      {% endfor %}
    </ul>
    {% else %}
    <p>{{ _("The work processes of this core task did not change.") }}</p>
    {% endif %}
    {% else %}
    <p>{{ _("This dossier version has expired (%(d)s).", d=q.valid_until.strftime("%d-%m-%Y")) }}</p>
    {% endif %}
  </div>
</div>
{% endif %}
{% endif %}

<section class="card">
  <h2>{{ _("Settings") }}</h2>
  <dl class="details">
    {% if dossier %}
    <dt>{{ _("Qualification") }}</dt><dd><span class="mono">{{ dossier.qualification.crebo }}</span> {{ dossier.qualification.name }} <span class="muted small">({{ _("dossier %(v)s", v=dossier.qualification.dossier_version) }})</span></dd>
    <dt>{{ _("Core task") }}</dt><dd class="mono">{{ exam_template.core_task_code }}</dd>
    {% endif %}
    <dt>{{ _("Access code required") }}</dt><dd>{{ _("Yes") if config.get("access_code_enabled", True) else _("No") }}</dd>
    <dt>{{ _("IP restriction") }}</dt><dd>{% if config.get("ip_restriction_enabled") %}{% if preset %}{{ preset.name }}{% if config.get("ip_cidrs") %}, {% endif %}{% endif %}<span class="mono">{{ (config.get("ip_cidrs") or [])|join(", ") }}</span>{% else %}{{ _("No") }}{% endif %}</dd>
    <dt>{{ _("Allowed extensions") }}</dt><dd><span class="mono">{{ (config.get("extensions") or [])|join(", ") }}</span></dd>
    <dt>{{ _("Maximum size") }}</dt><dd>{{ _("%(f)s MB per file, %(s)s MB per submission", f=config.get("max_file_mb"), s=config.get("max_submission_mb")) }}</dd>
    <dt>{{ _("Extra files") }}</dt><dd>{{ _("Allowed") if config.get("allow_extra_file", True) else _("Not allowed") }}</dd>
    <dt>{{ _("Students not on the class list") }}</dt><dd>{{ _("Allowed") if config.get("allow_unlisted", True) else _("Not allowed") }}</dd>
    <dt>{{ _("Created") }}</dt><dd>{{ exam_template.created_at|localtime }}</dd>
  </dl>
</section>

<section>
  <h2>{{ _("Expected files") }}</h2>
  {% if exam_template.slots %}
  <div class="table-wrap">
  <table>
    <thead><tr><th scope="col">#</th><th scope="col">{{ _("Label") }}</th><th scope="col">{{ _("Expected file name") }}</th><th scope="col">{{ _("Extensions") }}</th><th scope="col">{{ _("Template file") }}</th></tr></thead>
    <tbody>
    {% for slot in exam_template.slots %}
      <tr>
        <td>{{ slot.position }}</td>
        <td>{{ slot.label }}</td>
        <td class="mono">{{ slot.expected_name_pattern or "" }}</td>
        <td>{% if slot.extensions %}<span class="mono">{{ slot.extensions|join(", ") }}</span>{% else %}<span class="muted">{{ _("All allowed extensions") }}</span>{% endif %}</td>
        <td>
          {% if slot.template_file %}
          <a href="/examens/sjablonen/{{ exam_template.id }}/vakjes/{{ slot.id }}/sjabloon">{{ slot.template_file.original_name }}</a>
          <br><span class="mono small" title="SHA-256">{{ slot.template_file.sha256[:16] }}…</span>
          {% if can_manage %}<form method="post" action="/examens/sjablonen/{{ exam_template.id }}/vakjes/{{ slot.id }}/sjabloon/verwijderen" class="inline-form">{{ csrf() }}<button type="submit" class="button button-small button-danger">{{ _("Remove") }}<span class="visually-hidden"> {{ slot.template_file.original_name }}</span></button></form>{% endif %}
          {% elif not can_manage %}<span class="muted">{{ _("None") }}</span>
          {% else %}
          <form method="post" action="/examens/sjablonen/{{ exam_template.id }}/vakjes/{{ slot.id }}/sjabloon" enctype="multipart/form-data" class="upload-form">
            {{ csrf() }}
            <label class="visually-hidden" for="tpl-{{ slot.id }}">{{ _("Template file for %(label)s", label=slot.label) }}</label>
            <input id="tpl-{{ slot.id }}" type="file" name="file" required>
            <button type="submit" class="button button-small button-secondary">{{ _("Upload") }}</button>
          </form>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p class="muted">{{ _("No expected files: students hand in extra files only.") }}</p>
  {% endif %}
</section>

{% if copy_teams %}
<section class="card">
  <h2>{% include "_tcp_mark.html.j2" %}{{ _("Copy to a team") }}</h2>
  <p>{{ _("A copy in a team is available to every member of that team. This template stays as it is.") }}</p>
  <form method="post" action="/examens/sjablonen/{{ exam_template.id }}/kopie" class="row-form">
    {{ csrf() }}
    {% if copy_teams|length == 1 %}
    <input type="hidden" name="team_id" value="{{ copy_teams[0].id }}">
    <button type="submit" class="button button-tcp">{% include "_tcp_mark.html.j2" %}{{ _("Copy to %(team)s", team=copy_teams[0].name) }}</button>
    {% else %}
    <div class="field">
      <label for="copy-team">{{ _("Education team") }}</label>
      <select id="copy-team" name="team_id">{% for t in copy_teams %}<option value="{{ t.id }}">{{ t.name }}</option>{% endfor %}</select>
    </div>
    <button type="submit" class="button button-tcp">{% include "_tcp_mark.html.j2" %}{{ _("Copy to team") }}</button>
    {% endif %}
  </form>
</section>
{% endif %}
{% if can_manage %}
<section class="card danger-zone">
  <h2>{% if exam_template.team_id %}{% include "_tcp_mark.html.j2" %}{% endif %}{{ _("Delete template") }}</h2>
  <p>{{ _("Exams made from this template keep their settings and template files.") }}</p>
  <form method="post" action="/examens/sjablonen/{{ exam_template.id }}/verwijderen">
    {{ csrf() }}<button type="submit" class="button button-danger">{{ _("Delete template") }}</button>
  </form>
</section>
{% endif %}
{% endblock %}
