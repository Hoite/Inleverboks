<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<title>{{ _("Receipt") }} {{ receipt_code }}</title>
<style>
  @page { size: A4; margin: 18mm 16mm 20mm; @bottom-right { content: counter(page) " / " counter(pages); font-size: 8pt; color: #5b6770; } }
  body { font-family: "DejaVu Sans", Arial, sans-serif; font-size: 10pt; color: #313131; }
  /* Long names and file names must wrap instead of running off the page. */
  h1, h2, p, dd, li { overflow-wrap: anywhere; }
  h1 { color: #005381; font-size: 16pt; margin: 0 0 4mm; border-bottom: 1.5pt solid #e73443; padding-bottom: 2mm; }
  h2 { color: #005381; font-size: 11pt; margin: 6mm 0 2mm; }
  dl { display: grid; grid-template-columns: 40mm minmax(0, 1fr); gap: 1.5mm 4mm; margin: 0; }
  dt { font-weight: bold; }
  dd { margin: 0; }
  .mono { font-family: "DejaVu Sans Mono", monospace; word-break: break-all; }
  .code { font-size: 13pt; letter-spacing: 1pt; }
  ul { padding-left: 5mm; }
  li { margin-bottom: 2.5mm; }
  .hash { font-size: 8.5pt; }
  .note { margin-top: 8mm; font-size: 9pt; color: #5b6770; }
</style>
</head>
<body>
  <h1>{{ app_name if app_name is defined else "Inleverboks" }} · {{ _("Receipt") }}</h1>
  <dl>
    <dt>{{ _("Hand-in code") }}</dt><dd class="mono code">{{ receipt_code }}</dd>
    {% if verification_code %}<dt>{{ _("Verification code") }}</dt><dd class="mono code">{{ verification_code }}</dd>{% endif %}
    <dt>{{ _("Exam") }}</dt><dd>{{ exam_name }}</dd>
    <dt>{{ _("Name") }}</dt><dd>{{ student_name }}</dd>
    <dt>{{ _("Student number") }}</dt><dd class="mono">{{ student_number }}</dd>
    <dt>{{ _("Handed in at") }}</dt><dd>{{ started_at|localtime("%d-%m-%Y %H:%M:%S") }} ({{ _("server time") }})</dd>
  </dl>
  <h2>{{ _("Files") }}</h2>
  <ul>
  {% for f in files %}
    <li><strong>{{ f.name }}</strong> · {{ f.slot or _("Extra file") }} · {{ f.size }} bytes<br>
      <span class="mono hash">SHA-256: {% for i in range(0, 64, 8) %}{{ f.sha256[i:i+8] }} {% endfor %}</span></li>
  {% endfor %}
  </ul>
  {% if warnings %}
  <h2>{{ _("Confirmed warnings") }}</h2>
  <ul>{% for w in warnings %}<li>{{ warning_labels.get(w.code, w.code) }}{% if w.get('file') %}: {{ w.file }}{% endif %}{% if w.get('slot') %}: {{ w.slot }}{% endif %}{% if w.get('expected') %} ({{ w.actual }} / {{ w.expected }}){% endif %}</li>{% endfor %}</ul>
  {% endif %}
  <p>✓ {{ _("I declare that this is my own work and that my hand-in is complete.") }}</p>
  <p class="note">{{ _("Keep this receipt. You cannot request it again later.") }}</p>
</body>
</html>
