<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
{% include "pdf/_pdf_style.html.j2" %}
</head>
<body>
<div class="footer">{{ _("Generated") }} {{ generated_at|localtime("%d-%m-%Y %H:%M:%S") }} · {{ _("Audit log hash") }} <span class="mono">{{ head }}</span></div>
<div class="brand">{{ app_name }}</div>
<h1>{{ title }}</h1>
<p>{% if issues %}<span class="bad">{{ _("The hash chain is broken.") }}</span>{% else %}{{ _("Hash chain intact: %(n)s events checked.", n=checked) }}{% endif %}</p>
<table>
  <thead><tr><th>#</th><th>{{ _("Time") }}</th><th>{{ _("Actor") }}</th><th>{{ _("IP address") }}</th><th>{{ _("Event") }}</th><th>{{ _("Details") }}</th></tr></thead>
  <tbody>
  {% for e in events %}
    <tr><td>{{ e.seq }}</td><td>{{ e.ts|localtime("%d-%m-%Y %H:%M:%S") }}</td><td>{{ e.actor_label }}</td><td class="mono">{{ e.ip or "" }}</td>
      <td class="mono">{{ e.event }}</td><td class="mono">{{ e.details|tojson }}</td></tr>
  {% endfor %}
  </tbody>
</table>
</body>
</html>
