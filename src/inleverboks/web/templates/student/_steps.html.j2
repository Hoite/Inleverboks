{% macro remaining_text(seconds) %}{{ (seconds // 3600)|int }}:{{ "%02d"|format(((seconds % 3600) // 60)|int) }}{% endmacro %}

{% macro error_box(error) %}
{% if error %}
<div class="alert alert-error" role="alert"><span class="alert-icon" aria-hidden="true">!</span><div><p>{{ error }}</p></div></div>
{% endif %}
{% endmacro %}
