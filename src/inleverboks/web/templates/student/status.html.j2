{% extends "student/_layout.html.j2" %}
{% block refresh %}{% if entry in ("scheduled", "concept") %}<meta http-equiv="refresh" content="60">{% endif %}{% endblock %}
{% block student %}
{% if entry == "concept" %}
<div class="alert alert-warning" role="status"><span class="alert-icon" aria-hidden="true">!</span>
  <div><p>{{ _("This hand-in link has not been opened yet by the teacher.") }}</p></div></div>
{% elif entry == "scheduled" %}
<div class="alert alert-warning" role="status"><span class="alert-icon" aria-hidden="true">◔</span>
  <div><p>{{ _("Not opened yet (opens at %(t)s).", t=exam.starts_at|localtime("%H:%M")) }}</p></div></div>
{% elif entry == "ip_denied" %}
<div class="alert alert-error" role="alert"><span class="alert-icon" aria-hidden="true">!</span>
  <div><p>{{ _("You cannot hand in from this network. Use a school computer or report to the teacher.") }}</p></div></div>
{% else %}
<div class="alert alert-error" role="status"><span class="alert-icon" aria-hidden="true">■</span>
  <div><p>{{ _("Closed") }}</p></div></div>
{% endif %}
{% endblock %}
