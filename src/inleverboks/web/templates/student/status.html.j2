{% extends "base.html.j2" %}
{% block title %}{{ exam.name }} · {{ app_name }}{% endblock %}
{% block header_nav %}{% endblock %}
{% block content %}
<div class="narrow student">
  <h1>{{ exam.name }}</h1>
  <p class="muted">{{ _("Server time") }}: <span class="mono">{{ now|localtime("%H:%M") }}</span></p>
  {% if status == "concept" %}
  <div class="alert alert-warning" role="status"><span class="alert-icon" aria-hidden="true">!</span>
    <div><p>{{ _("This hand-in link has not been opened yet by the teacher.") }}</p></div></div>
  {% elif status == "scheduled" %}
  <div class="alert alert-warning" role="status"><span class="alert-icon" aria-hidden="true">◔</span>
    <div><p>{{ _("Not opened yet (opens at %(t)s).", t=exam.starts_at|localtime("%H:%M")) }}</p></div></div>
  {% elif status == "open" %}
  {% if remaining and remaining.total_seconds() > 0 %}
  <p>{{ _("Time remaining") }}: <strong class="mono">{{ (remaining.total_seconds() // 3600)|int }}:{{ "%02d"|format(((remaining.total_seconds() % 3600) // 60)|int) }}</strong></p>
  {% endif %}
  <p class="muted">{{ _("Handing in opens here.") }}</p>
  {% else %}
  <div class="alert alert-error" role="status"><span class="alert-icon" aria-hidden="true">■</span>
    <div><p>{{ _("Closed") }}</p></div></div>
  {% endif %}
</div>
{% endblock %}
