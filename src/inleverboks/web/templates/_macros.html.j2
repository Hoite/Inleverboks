{% macro csrf() %}<input type="hidden" name="csrf_token" value="{{ csrf_token }}">{% endmacro %}

{% macro errors_box(errors) %}
{% if errors %}
<div class="alert alert-error" role="alert">
  <span class="alert-icon" aria-hidden="true">!</span>
  <div>
    {% if errors|length == 1 %}<p>{{ errors[0] }}</p>{% else %}
    <p>{{ errors[0] }}</p>
    <ul>{% for e in errors[1:] %}<li>{{ e }}</li>{% endfor %}</ul>
    {% endif %}
  </div>
</div>
{% endif %}
{% endmacro %}

{% macro ok_box(text) %}
<div class="alert alert-success" role="status">
  <span class="alert-icon" aria-hidden="true">✓</span>
  <div><p>{{ text }}</p></div>
</div>
{% endmacro %}

{% macro field_error(errors, name) %}
{% if errors.get(name) %}<p class="field-error" id="{{ name }}-error"><span aria-hidden="true">!</span> {{ errors[name] }}</p>{% endif %}
{% endmacro %}

{# Date picker plus a 24-hour time field. A datetime-local input follows the browser's
   language and shows AM/PM in English browsers; this always uses hh:mm. #}
{% macro datetime_input(name, label, date, time, attrs="") %}
<fieldset class="datetime-field">
  <legend>{{ label }}</legend>
  <div class="datetime-inputs">
    <div class="field">
      <label for="{{ name }}_date">{{ _("Date") }}</label>
      <input id="{{ name }}_date" name="{{ name }}_date" type="date" required value="{{ date }}"{{ attrs }}>
    </div>
    <div class="field">
      <label for="{{ name }}_time">{{ _("Time (24-hour)") }}</label>
      <input id="{{ name }}_time" name="{{ name }}_time" type="text" required value="{{ time }}" inputmode="numeric" maxlength="5" size="5" class="time-input mono" placeholder="09:00" pattern="([01]?[0-9]|2[0-3])[:.]?[0-5][0-9]" autocomplete="off"{{ attrs }}>
    </div>
  </div>
</fieldset>
{% endmacro %}
