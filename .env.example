# Inleverboks configuration. Copy to .env and adjust. Never commit .env.
# All variables are documented in README.md (Configuratie).

# Public URL, used for hand-in links and QR codes.
APP_BASE_URL=http://localhost:8080
# Required, at least 32 characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DATABASE_URL=sqlite:////data/inleverboks.db

# local | s3
STORAGE_BACKEND=local
STORAGE_PATH=/data/files
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Bootstrap of the first (local) admin. Empty password: a strong one is generated and
# shown once in the log.
ADMIN_EMAIL=
ADMIN_PASSWORD=

APP_TIMEZONE=Europe/Amsterdam
# Comma-separated CIDR list of proxies whose X-Forwarded-For/-Proto are trusted,
# e.g. the pod range of the ingress controller. Empty: forwarded headers are ignored.
TRUSTED_PROXIES=

MAX_FILE_MB=25
MAX_SUBMISSION_MB=100
MAX_FILES_PER_SUBMISSION=20

SCHEDULER_ENABLED=true
# Set to false in Kubernetes (an initContainer runs the migrations).
RUN_MIGRATIONS_ON_START=true

BACKUP_PATH=
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAYS=7

# false only for local development over plain HTTP.
SESSION_COOKIE_SECURE=true
# Enable behind TLS.
HSTS_ENABLED=false

# debug | info | warning | error
LOG_LEVEL=info
# json | console
LOG_FORMAT=json

DEMO_MODE=false
